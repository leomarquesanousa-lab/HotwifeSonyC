{
  "name": "creator-platform",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium && next build",
    "start": "cross-env PLAYWRIGHT_BROWSERS_PATH=0 next start",
    "lint": "eslint",
    "manyvids:provision-session": "node scripts/provision-manyvids-session.mjs",
    "contract:emit": "prisma contract emit",
    "postinstall": "prisma skills sync || exit 0",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "email:test": "node scripts/email-test.mjs",
    "test:auth": "node scripts/test-auth.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@noble/hashes": "^2.4.0",
    "@prisma/orm-postgres": "^8.0.0-rc.9",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "argon2": "^0.45.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.0.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "resend": "^6.26.0",
    "simple-icons": "^16.30.0",
    "tailwind-merge": "^3.6.0",
    "vinext": "^1.0.0-beta.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@cloudflare/vite-plugin": "^1.54.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^8.0.0-rc.13",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
