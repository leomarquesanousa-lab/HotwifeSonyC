      {
        "description": "create table \"purchase\"",
        "sql": "CREATE TABLE \"public\".\"purchase\" (\n  \"amountCents\" int4 NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"currency\" text DEFAULT 'USD' NOT NULL,\n  \"id\" text NOT NULL,\n  \"status\" text DEFAULT 'PENDING' NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"userId\" text NOT NULL,\n  \"videoProductId\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"purchase_amount_nonnegative_9ba6fead\" CHECK (\"amountCents\" >= 0),\n  CONSTRAINT \"purchase_status_valid_e1b666af\" CHECK (status IN ('PENDING', 'PAID', 'CANCELED', 'REFUNDED'))\n)",
        "params": []
      }
    ],
    "postcheck": [
